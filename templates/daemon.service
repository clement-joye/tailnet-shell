[Unit]
Description=Tailscale for isolated tailnet @NAME@
Requires=tailnet-shell-@NAME@-netns.service
Wants=tailnet-shell-@NAME@-uplink.service
After=tailnet-shell-@NAME@-netns.service tailnet-shell-@NAME@-uplink.service
PartOf=tailnet-shell-@NAME@-netns.service

[Service]
ExecStart=/usr/bin/ip netns exec tn-@NAME@ /usr/bin/tailscaled --state=/var/lib/tailnet-shell/@NAME@/tailscaled.state --socket=/run/tailnet-shell-@NAME@/tailscaled.sock --port=0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
